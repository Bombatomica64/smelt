    %4 = copy %12.field19
    %5 = copy %12.field20
    %6 = copy %12.field21
    %7 = copy %12.field22
    %13 = unknown_is Null copy %7
    %14 = !copy %13
    switch copy %14 ? bb4 : bb5
  bb3:
