fn test_data_first_should_zip_with_predicate (FuncId(0)) -> None throws
  locals
    %0 temp: Dict<String, Unknown>
    %1 temp: Unknown
    %2 temp: List<String>
    %3 temp: List<String>
    %4 temp: fn(Unknown, Unknown) -> String
    %5 temp: Unknown
    %6 temp: List<String>
    %7 temp: Unknown
    %8 temp: Bool
  bb0:
    %0 = {}
    %1 = unknown_cast copy %0 as t0
    %2 = ["1", "2", "3"]
    %3 = ["a", "b", "c"]
    %4 = closure ClosureId(0) []
    %5 = closure_call copy %1(copy %2, copy %3, copy %4)
    %6 = ["1a", "2b", "3c"]
    %7 = copy %6
    %8 = copy %5 != copy %7
    switch copy %8 ? bb1 : bb2
  bb1:
    throw "expect(...).toStrictEqual(...) failed"
  bb2:
    return none

