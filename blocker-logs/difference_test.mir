fn test_returns_a_shallow_clone_when_nothing_is_removed (FuncId(2)) -> None throws
  locals
    %0 user data: List<Float>
    %1 user result: Unknown
    %2 temp: List<Float>
    %3 temp: Dict<String, Unknown>
    %4 temp: Unknown
    %5 temp: List<Float>
    %6 temp: Unknown
    %7 temp: Unknown
    %8 temp: Bool
    %9 temp: Unknown
    %10 temp: Bool
    %11 temp: Bool
  bb0:
    %2 = [1.0, 2.0, 3.0]
    %0 = copy %2
    %3 = {}
    %4 = unknown_cast copy %3 as t0
    %5 = [4.0, 5.0, 6.0]
    %6 = closure_call copy %4(copy %0, copy %5)
    %1 = copy %6
    %7 = copy %0
    %8 = copy %1 != copy %0
    switch copy %8 ? bb1 : bb2
  bb1:
    throw "expect(...).toStrictEqual(...) failed"
  bb2:
    %9 = copy %0
    %10 = copy %1 != copy %0
    %11 = !copy %10
    switch copy %11 ? bb3 : bb4
  bb3:
    throw "expect(...).toBe(...) failed"
  bb4:
    return none

