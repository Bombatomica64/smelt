fn test_returns_empty_array_on_empty_input (FuncId(0)) -> None throws
  locals
    %0 temp: Dict<String, Unknown>
    %1 temp: Unknown
    %2 temp: List<Unknown>
    %3 temp: List<Float>
    %4 temp: Unknown
    %5 temp: List<Unknown>
    %6 temp: Unknown
    %7 temp: Bool
  bb0:
    %0 = {}
    %1 = unknown_cast copy %0 as t0
    %2 = []
    %3 = [1.0, 2.0, 3.0]
    %4 = closure_call copy %1(copy %2, copy %3)
    %5 = []
    %6 = copy %5
    %7 = copy %4 != copy %6
    switch copy %7 ? bb1 : bb2
  bb1:
    throw "expect(...).toStrictEqual(...) failed"
  bb2:
    return none

