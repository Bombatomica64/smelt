fn main (FuncId(0)) -> None
  locals
    %0 user i: Int
    %1 user total: Int
    %2 temp: Bool
    %3 temp: Int
    %4 temp: Int
    %5 temp: None
  bb0:
    %0 = 0
    %1 = 0
    goto bb1
  bb1:
    %2 = copy %0 < 4
    switch move %2 ? bb2 : bb3
  bb2:
    %3 = move %1 + copy %0
    %1 = move %3
    %4 = move %0 + 1
    %0 = move %4
    goto bb1
  bb3:
    %5 = call @console_log(move %1) -> bb4
  bb4:
    return none

