fn range (FuncId(0)) -> Generator<Float, None, None>
  locals
    %0 param start: Float
    %1 param end: Float
    %2 param step: Optional<Float>
    %3 user step: Float
    %4 user i: Float
    %5 temp: Float
    %6 temp: Bool
    %7 temp: Float
    %8 temp: None
    %9 temp: Float
  bb0:
    %3 = copy %2 ?? 1.0
    %4 = copy %0
    goto bb1
  bb1:
    %6 = copy %4 <= copy %1
    switch move %6 ? bb2 : bb4
  bb2:
    %8 = yield copy %4
    goto bb3
  bb3:
    %9 = move %4 + copy %3
    %4 = move %9
    goto bb1
  bb4:
    return none

fn labels (FuncId(1)) -> Generator<String, None, None>
  locals
    %0 param count: Float
    %1 user i: Float
    %2 temp: Bool
    %3 temp: String
    %4 temp: String
    %5 temp: None
    %6 temp: Float
  bb0:
    %1 = 0.0
    goto bb1
  bb1:
    %2 = copy %1 < copy %0
    switch move %2 ? bb2 : bb4
  bb2:
    %4 = "item-" + copy %1
    %5 = yield move %4
    goto bb3
  bb3:
    %6 = move %1 + 1.0
    %1 = move %6
    goto bb1
  bb4:
    return none

fn main (FuncId(2)) -> None throws
  locals
    %0 user from_range: List<Float>
    %1 user spread_range: List<Float>
    %2 user names: List<String>
    %3 user again: List<Float>
    %4 temp: Generator<Float, None, None>
    %5 temp: List<Float>
    %6 temp: Float
    %7 temp: None
    %8 temp: Generator<Float, None, None>
    %9 temp: List<Float>
    %10 temp: String
    %11 temp: None
    %12 temp: Generator<String, None, None>
    %13 temp: List<String>
    %14 temp: String
    %15 temp: None
    %16 temp: Generator<Float, None, None>
    %17 temp: List<Float>
    %18 temp: Float
    %19 temp: Float
    %20 temp: None
  bb0:
    %4 = call fn0(1.0, 5.0) -> bb1
  bb1:
    %5 = call @generator_collect(move %4) -> bb2
  bb2:
    %0 = move %5
    %6 = len copy %0
    %7 = call @console_log(move %6, copy %0[0.0], copy %0[4.0]) -> bb3
  bb3:
    %8 = call fn0(0.0, 10.0, 5.0) -> bb4
  bb4:
    %9 = call @generator_collect(move %8) -> bb5
  bb5:
    %1 = move %9
    %10 = string_join move %1, ","
    %11 = call @console_log(move %10) -> bb6
  bb6:
    %12 = call fn1(3.0) -> bb7
  bb7:
    %13 = call @generator_collect(move %12) -> bb8
  bb8:
    %2 = move %13
    %14 = string_join move %2, " "
    %15 = call @console_log(move %14) -> bb9
  bb9:
    %16 = call fn0(2.0, 3.0) -> bb10
  bb10:
    %17 = call @generator_collect(move %16) -> bb11
  bb11:
    %3 = move %17
    %18 = len copy %3
    %19 = copy %3[0.0] + copy %3[1.0]
    %20 = call @console_log(move %18, move %19) -> bb12
  bb12:
    return none

