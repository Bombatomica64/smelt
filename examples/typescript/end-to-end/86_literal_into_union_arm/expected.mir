  bb11:
    %27 = "ambiguous: " + move %26
    %28 = call @console_log(move %27) -> bb12
  bb12:
    return none

closure ClosureId(0) -> String
  locals
    %0 param __callback_param_0: (String, Float)
    %1 param __callback_param_1: Int
    %2 param __callback_param_2: List<(String, Float)>
    %3 temp: String
    %4 temp: String
    %5 temp: String
  bb0:
    %3 = copy %0[0] + "="
    %4 = primitive_cast_string copy %0[1]
    %5 = copy %3 + copy %4
    return copy %5

