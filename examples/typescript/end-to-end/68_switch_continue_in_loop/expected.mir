fn escape_html (FuncId(0)) -> String
  locals
    %0 param str: String
    %1 user out: String
    %2 user last_index: Float
    %3 user i: Float
    %4 user code: Float
    %5 user replacement: String
    %6 temp: Float
    %7 temp: Bool
    %8 temp: Float
    %9 temp: String
    %10 temp: String
    %11 temp: String
    %12 temp: Float
    %13 temp: Float
    %14 temp: Float
    %15 temp: String
    %16 temp: String
  bb0:
    %1 = ""
    %2 = 0.0
    %3 = 0.0
    goto bb1
  bb1:
    %6 = len copy %0
    %7 = copy %3 < move %6
    switch move %7 ? bb2 : bb4
  bb2:
    %8 = string_char_code_at copy %0, copy %3
    %4 = move %8
    %5 = ""
    match move %4 {34.0 => bb5, 38.0 => bb6, 60.0 => bb7, 62.0 => bb8, _ => bb9}
  bb3:
    %13 = move %3 + 1.0
    %3 = move %13
    goto bb1
  bb4:
    %14 = len copy %0
    %15 = string_slice copy %0, move %2, move %14
    %16 = move %1 + move %15
    return move %16
  bb5:
    %5 = "&quot;"
    goto bb10
  bb6:
    %5 = "&amp;"
    goto bb10
  bb7:
    %5 = "&lt;"
    goto bb10
  bb8:
    %5 = "&gt;"
    goto bb10
  bb9:
    goto bb3
  bb10:
    %9 = string_slice copy %0, move %2, copy %3
    %10 = move %9 + move %5
    %11 = move %1 + move %10
    %1 = move %11
    %12 = copy %3 + 1.0
    %2 = move %12
    goto bb3

