fn main (FuncId(0)) -> None
  locals
    %0 user i: usize
    %1 user sum: Float
    %2 temp: Bool
    %3 temp: Float
    %4 temp: Float
    %5 temp: None
    %6 temp: Float
  bb0:
    %0 = 0
    %1 = 0.0
    goto bb1
  bb1:
    %2 = copy %0 < 4
    switch move %2 ? bb2 : bb3
  bb2:
    %6 = primitive_cast_float copy %0
    %1 = move %1 + move %6
    %0 = move %0 + 1
    goto bb1
  bb3:
    %5 = call @console_log(move %1) -> bb4
  bb4:
    return none

