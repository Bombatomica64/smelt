fn main (FuncId(0)) -> None
  locals
    %0 user ready: Bool
    %1 user blocked: Bool
    %2 user value: Float
    %3 temp: Float
    %4 temp: Bool
    %5 temp: Bool
    %6 temp: Bool
    %7 temp: None
  bb0:
    %0 = true
    %1 = false
    %3 = -3.0
    %2 = move %3
    %4 = !move %1
    switch copy %4 ? bb1 : bb2
  bb1:
    %5 = copy %0
    goto bb3
  bb2:
    %5 = false
    goto bb3
  bb3:
    switch copy %5 ? bb4 : bb5
  bb4:
    %6 = move %0
    goto bb6
  bb5:
    %6 = false
    goto bb6
  bb6:
    %7 = call @console_log(move %6, move %2) -> bb7
  bb7:
    return none

