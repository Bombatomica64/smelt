fn main (FuncId(0)) -> None
  locals
    %0 user code: Float
    %1 user label: String
    %2 temp: None
  bb0:
    %0 = 2.0
    %1 = ""
    match move %0 {1.0 => bb2, 2.0 => bb3, _ => bb4}
  bb1:
    %2 = call @console_log(move %1) -> bb5
  bb2:
    %1 = "one"
    goto bb1
  bb3:
    %1 = "two"
    goto bb1
  bb4:
    %1 = "other"
    goto bb1
  bb5:
    return none

