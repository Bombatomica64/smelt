fn main (FuncId(0)) -> None
  locals
    %0 user code: Float
    %1 user label: String
    %2 temp: None
  bb0:
    %0 = 2.0
    %1 = ""
    match move %0 {1.0 => bb1, 2.0 => bb2, _ => bb3}
  bb1:
    %1 = "one"
    goto bb4
  bb2:
    %1 = "two"
    goto bb4
  bb3:
    %1 = "other"
    goto bb4
  bb4:
    %2 = call @console_log(move %1) -> bb5
  bb5:
    return none

