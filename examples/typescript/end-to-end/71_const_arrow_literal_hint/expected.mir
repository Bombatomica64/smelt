    %13 = call @console_log(move %12) -> bb4
  bb4:
    %14 = closure ClosureId(2) []
    %15 = {"label": "partial"}
    %16 = closure_call move %14(move %15)
    %17 = call @console_log(move %16) -> bb5
  bb5:
    %18 = closure_call move %0()
    %19 = call @console_log(move %18) -> bb6
  bb6:
    %20 = closure ClosureId(3) []
    %2 = move %20
    %21 = {"status": 1.0}
    %22 = {"status": 2.0, "label": "two"}
    %23 = [move %21, move %22]
    %24 = closure_call move %2(move %23)
    %25 = call @console_log(move %24) -> bb7
  bb7:
