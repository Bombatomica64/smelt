interface Opts

fn show_fn (FuncId(0)) -> String
  locals
    %0 param opts: Opts
    %1 temp: Float
    %2 temp: String
    %3 temp: String
    %4 temp: String
    %5 temp: String
  bb0:
    %1 = copy %0.field3 ?? 0.0
    %2 = "fn " + move %1
    %3 = move %2 + " "
    %4 = copy %0.field4 ?? "-"
    %5 = move %3 + move %4
    return move %5

fn main (FuncId(1)) -> None
  locals
