  bb0:
    %3 = closure ClosureId(0) []
    %0 = move %3
    %4 = {"status": 8.0, "label": "fn"}
    %5 = call fn0(move %4) -> bb1
  bb1:
    %6 = call @console_log(move %5) -> bb2
  bb2:
    %7 = {"status": 7.0, "label": "opt"}
    %8 = closure_call copy %0(move %7)
    %9 = call @console_log(move %8) -> bb3
  bb3:
