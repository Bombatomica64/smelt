interface Opts

fn show_fn (FuncId(0)) -> String
  locals
    %0 param opts: Opts
    %1 temp: Float
    %2 temp: String
    %3 temp: String
    %4 temp: String
    %5 temp: String
  bb0:
    %1 = copy %0.field3 ?? 0.0
    %2 = "fn " + move %1
    %3 = move %2 + " "
    %4 = copy %0.field4 ?? "-"
    %5 = move %3 + move %4
    return move %5

fn main (FuncId(1)) -> None
  locals
    %0 user show_optional: fn(Optional<Opts>) -> String
    %1 user show_required: fn(Opts) -> String
    %2 user total: fn(List<Opts>) -> Float
    %3 temp: fn(Optional<Opts>) -> String
    %4 temp: fn(Opts) -> String
    %5 temp: Opts
    %6 temp: String
    %7 temp: None
    %8 temp: Opts
    %9 temp: String
    %10 temp: None
    %11 temp: Opts
    %12 temp: String
    %13 temp: None
    %14 temp: Opts
    %15 temp: String
    %16 temp: None
    %17 temp: String
    %18 temp: None
    %19 temp: fn(List<Opts>) -> Float
    %20 temp: Opts
    %21 temp: Opts
    %22 temp: List<Opts>
    %23 temp: Float
    %24 temp: None
  bb0:
    %3 = closure ClosureId(0) []
    %0 = move %3
    %4 = closure ClosureId(1) []
    %1 = move %4
    %5 = {"status": 8.0, "label": "fn"}
    %6 = call fn0(move %5) -> bb1
  bb1:
    %7 = call @console_log(move %6) -> bb2
  bb2:
    %8 = {"status": 7.0, "label": "opt"}
    %9 = closure_call copy %0(move %8)
    %10 = call @console_log(move %9) -> bb3
  bb3:
    %11 = {"status": 9.0, "label": "req"}
    %12 = closure_call copy %1(move %11)
    %13 = call @console_log(move %12) -> bb4
  bb4:
    %14 = {"label": "partial"}
    %15 = closure_call move %1(move %14)
    %16 = call @console_log(move %15) -> bb5
  bb5:
    %17 = closure_call move %0(none)
    %18 = call @console_log(move %17) -> bb6
  bb6:
    %19 = closure ClosureId(2) []
    %2 = move %19
    %20 = {"status": 1.0}
    %21 = {"status": 2.0, "label": "two"}
    %22 = [move %20, move %21]
    %23 = closure_call move %2(move %22)
    %24 = call @console_log(move %23) -> bb7
  bb7:
    return none

closure ClosureId(0) -> String
  locals
    %0 param opts: Optional<Opts>
    %1 temp: Optional<Float>
    %2 temp: Float
    %3 temp: String
    %4 temp: String
    %5 temp: Optional<String>
    %6 temp: String
    %7 temp: String
  bb0:
    %1 = copy %0?.field3
    %2 = copy %1 ?? 0.0
    %3 = "optional " + copy %2
    %4 = copy %3 + " "
    %5 = copy %0?.field4
    %6 = copy %5 ?? "-"
    %7 = copy %4 + copy %6
    return copy %7

closure ClosureId(1) -> String
  locals
    %0 param opts: Opts
    %1 temp: Float
    %2 temp: String
    %3 temp: String
    %4 temp: String
    %5 temp: String
  bb0:
    %1 = copy %0.field3 ?? 0.0
    %2 = "required " + copy %1
    %3 = copy %2 + " "
    %4 = copy %0.field4 ?? "-"
    %5 = copy %3 + copy %4
    return copy %5

closure ClosureId(2) -> Float
  locals
    %0 param items: List<Opts>
    %1 user sum: Float
    %2 user item: Opts
    %3 temp: usize
    %4 temp: usize
    %5 temp: Bool
    %6 temp: Float
    %7 temp: Float
  bb0:
    %1 = 0.0
    %3 = 0
    goto bb1
  bb1:
    %4 = len copy %0
    %5 = copy %3 < copy %4
    switch copy %5 ? bb2 : bb4
  bb2:
    %2 = copy %0[copy %3]
    %6 = copy %2.field3 ?? 0.0
    %7 = copy %1 + copy %6
    %1 = copy %7
    goto bb3
  bb3:
    %3 = copy %3 + 1
    goto bb1
  bb4:
    return copy %1

