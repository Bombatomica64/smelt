closure ClosureId(0) -> String
  locals
    %0 param opts: Optional<Opts>
    %1 temp: Optional<Float>
    %2 temp: Float
    %3 temp: String
    %4 temp: String
    %5 temp: Optional<String>
    %6 temp: String
