fn describe (FuncId(0)) -> String
  locals
    %0 param request: Request
    %1 temp: String
    %2 temp: String
    %3 temp: String
    %4 temp: Bool
    %5 temp: String
    %6 temp: String
    %7 temp: String
    %8 temp: String
    %9 temp: String
    %10 temp: List<String>
    %11 temp: String
  bb0:
    %1 = request_cache copy %0
    %2 = request_credentials copy %0
    %3 = request_integrity copy %0
    %4 = request_keepalive copy %0
    %5 = "" + move %4
    %6 = request_mode copy %0
    %7 = request_redirect copy %0
    %8 = request_referrer copy %0
    %9 = request_referrer_policy copy %0
    %10 = [move %1, move %2, move %3, move %5, move %6, move %7, move %8, move %9]
    %11 = string_join move %10, "|"
    return move %11

