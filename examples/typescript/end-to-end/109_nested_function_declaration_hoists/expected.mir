fn pick_label (FuncId(3)) -> String
  locals
    %0 param flag: Bool
    %1 user decorate: fn(String) -> String
    %2 temp: fn(String) -> String
    %3 temp: String
  bb0:
    switch copy %0 ? bb1 : bb2
  bb1:
    %2 = closure ClosureId(3) []
    %1 = move %2
    %3 = closure_call move %1("on")
    return move %3
  bb2:
