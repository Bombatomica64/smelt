fn scaled (FuncId(0)) -> Float
  locals
    %0 param base: Float
    %1 user step: fn(Float) -> Float
    %2 user scale: Float
    %3 temp: fn(Float) -> Float
    %4 temp: Float
  bb0:
    %2 = 3.0
    %3 = closure ClosureId(0) [copy %2]
    %1 = move %3
    %4 = closure_call move %1(copy %0)
    return move %4

