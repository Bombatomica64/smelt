fn sift_down (FuncId(0)) -> None
  locals
    %0 param heap: List<T>
    %1 param index: Float
    %2 param compare: fn(T, T) -> Float
    %3 user left: Float
    %4 user held: T
    %5 temp: Float
    %6 temp: Float
    %7 temp: Float
    %8 temp: Bool
    %9 temp: Bool
    %10 temp: Float
    %11 temp: Bool
  bb0:
    %5 = copy %1 * 2.0
    %3 = move %5 + 1.0
    %7 = len copy %0
    %8 = copy %3 < move %7
    switch move %8 ? bb1 : bb2
  bb1:
    %10 = closure_call copy %2(copy %0[copy %3], copy %0[copy %1])
    %11 = move %10 < 0.0
    %9 = move %11
    goto bb3
  bb2:
    %9 = false
    goto bb3
  bb3:
    switch move %9 ? bb4 : bb5
  bb4:
    %4 = copy %0[copy %3]
    %0[copy %3] = copy %0[copy %1]
    %0[copy %1] = move %4
    goto bb5
  bb5:
    return none

fn heapify (FuncId(1)) -> None
  locals
    %0 param heap: List<T>
    %1 param compare: fn(T, T) -> Float
    %2 user index: Float
    %3 temp: Float
    %4 temp: Float
    %5 temp: Float
    %6 temp: Float
    %7 temp: Bool
    %8 temp: None
    %9 temp: Float
  bb0:
    %3 = len copy %0
    %4 = move %3 / 2.0
    %5 = numeric_floor move %4
    %2 = move %5 - 1.0
    goto bb1
  bb1:
    %7 = copy %2 >= 0.0
    switch move %7 ? bb2 : bb4
  bb2:
    %8 = call fn0(copy %0, copy %2, copy %1) -> bb5
  bb3:
    %9 = move %2 - 1.0
    %2 = move %9
    goto bb1
  bb4:
    return none
  bb5:
    goto bb3

fn smallest_first (FuncId(2)) -> List<T>
  locals
    %0 param data: List<T>
    %1 param compare: fn(T, T) -> Float
    %2 param size: Float
    %3 user heap: List<T>
    %4 temp: List<T>
    %5 temp: None
  bb0:
    %3 = list_slice copy %0, 0.0, copy %2
    %5 = call fn1(copy %3, copy %1) -> bb1
  bb1:
