    %7 temp: InitLike
    %8 temp: Optional<Headers>
    %9 temp: Bool
    %10 temp: Headers
    %11 temp: Optional<String>
    %12 temp: String
  bb0:
    %3 = instanceof copy %0, class2
    switch move %3 ? bb1 : bb2
  bb1:
    %5 = copy %0
    %6 = response_headers move %5
    %4 = move %6
    goto bb3
  bb2:
    %7 = copy %0
    %4 = copy %7.field9
    goto bb3
  bb3:
    %8 = move %4
    %2 = move %8
    %9 = copy %2 == undefined
    switch move %9 ? bb4 : bb5
  bb4:
    return "none"
  bb5:
    %10 = move %2
    %11 = headers_get move %10, copy %1
    %12 = move %11 ?? "none"
    return move %12

