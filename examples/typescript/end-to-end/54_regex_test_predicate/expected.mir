  bb0:
    %6 = external_new0("^[0-9a-f]{4}$", "")
    %7 = regex_search move %6, "0a1b"
    %8 = call @console_log(move %7) -> bb1
  bb1:
    %9 = external_new0("^[0-9a-f]{4}$", "")
    %10 = regex_search move %9, "zzzz"
    %11 = call @console_log(move %10) -> bb2
  bb2:
    %12 = external_new0("ab", "i")
