    return none

closure ClosureId(0) -> Bool
  locals
    %0 param word: String
    %1 temp: RegExp
    %2 temp: Bool
  bb0:
    %1 = external_new0("^[ad]", "")
    %2 = regex_search copy %1, copy %0
    return copy %2

closure ClosureId(1) -> Bool
  locals
    %0 param word: String
    %1 temp: RegExp
    %2 temp: Bool
  bb0:
    %1 = external_new0("a", "")
    %2 = regex_search copy %1, copy %0
    return copy %2

closure ClosureId(2) -> Bool
  locals
    %0 param word: String
    %1 temp: RegExp
    %2 temp: Bool
  bb0:
    %1 = external_new0("^z", "")
    %2 = regex_search copy %1, copy %0
    return copy %2

