    %19 = call @console_log(move %18) -> bb5
  bb5:
    %20 = regex_search "b", "abc"
    %21 = call @console_log(move %20) -> bb6
  bb6:
    %22 = external_new0("^a+$", "i")
    %23 = regex_test move %22 "AAA"
    %24 = call @console_log(move %23) -> bb7
