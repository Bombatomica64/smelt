async fn greet (FuncId(0)) -> String
  locals
    %0 param name: String
    %1 temp: String
  bb0:
    %1 = "hello " + copy %0
    return move %1

async fn sum (FuncId(1)) -> Float
  locals
    %0 param values: List<Float>
    %1 user total: Float
    %2 user value: Float
    %3 temp: Float
    %4 temp: Float
    %5 temp: Bool
    %6 temp: Float
  bb0:
    %1 = 0.0
    %3 = 0.0
    goto bb1
  bb1:
    %4 = len copy %0
    %5 = copy %3 < move %4
    switch move %5 ? bb2 : bb4
  bb2:
    %2 = copy %0[copy %3]
    %6 = move %1 + move %2
    %1 = move %6
    goto bb3
  bb3:
    %3 = copy %3 + 1.0
    goto bb1
  bb4:
    return move %1

async fn main (FuncId(2)) -> None throws
  locals
