  bb0:
    %6 = closure ClosureId(0) []
    %0 = http_create_server move %6
    %8 = closure ClosureId(3) []
    %9 = http_server_listen copy %0 0.0 "127.0.0.1" move %8
    %1 = http_server_address copy %0
    switch true ? bb1 : bb2
  bb1:
    %12 = unknown_is Null copy %1
    %11 = !move %12
    goto bb3
  bb2:
    %11 = false
    goto bb3
  bb3:
    switch move %11 ? bb4 : bb5
  bb4:
    %15 = move %1
    %14 = copy %15.field14
    goto bb6
  bb5:
    %14 = 0.0
    goto bb6
  bb6:
    %2 = move %14
    %3 = "http://127.0.0.1:" + move %2
    %17 = "" + copy %3
    %18 = move %17 + "/echo?q=1"
    %19 = request_new input=move %18 method="POST" body="hello body"
    %20 = async_http_fetch(move %19)
    %4 = await move %20
    %22 = response_status copy %4
    %23 = call @console_log(move %22) -> bb7
  bb7:
    %24 = response_text move %4
    %25 = await move %24
    %26 = call @console_log(move %25) -> bb8
  bb8:
    %27 = "" + move %3
    %28 = move %27 + "/again"
    %29 = async_http_fetch(move %28)
    %5 = await move %29
    %31 = response_status copy %5
    %32 = call @console_log(move %31) -> bb9
  bb9:
    %33 = response_text move %5
    %34 = await move %33
    %35 = call @console_log(move %34) -> bb10
  bb10:
    %36 = http_server_close copy %0
    %37 = http_server_address move %0
    %38 = -1.0
    %39 = move %37 ?? move %38
    %40 = call @console_log(move %39) -> bb11
  bb11:
    %41 = async_exit_drain()
    %42 = await move %41
    return none

closure ClosureId(0) -> None
  locals
    %0 param req: IncomingMessage
    %1 param res: ServerResponse
    %2 user received: String
    %3 temp: fn(String) -> None
    %4 temp: IncomingMessage
    %5 temp: fn() -> None
    %6 temp: IncomingMessage
  bb0:
    %2 = ""
    %3 = closure ClosureId(1) [copy %2]
    %4 = emitter_on copy %0 "data" copy %3
    %5 = closure ClosureId(2) [copy %2, copy %0, copy %1]
    %6 = emitter_on copy %0 "end" copy %5
    return none

closure ClosureId(1) -> None
  locals
    %0 param chunk: String
    %1 user received: String
    %2 temp: String
    %3 temp: String
  bb0:
    %3 = copy %1 + copy %0
    %1 = copy %3
    return none

closure ClosureId(2) -> None
  locals
    %0 user received: String
    %1 user req: IncomingMessage
