    %30 = move %29 + "/again"
    %31 = async_http_fetch(move %30)
    %32 = await move %31
    %5 = move %32
    %33 = response_status copy %5
    %34 = call @console_log(move %33) -> bb9
  bb9:
    %35 = response_text move %5
    %36 = await move %35
    %37 = call @console_log(move %36) -> bb10
  bb10:
    %38 = http_server_close copy %0
    %39 = http_server_address move %0
    %40 = -1.0
    %41 = move %39 ?? move %40
    %42 = call @console_log(move %41) -> bb11
  bb11:
    %43 = async_exit_drain()
    %44 = await move %43
