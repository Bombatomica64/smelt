  bb6:
    %2 = move %16
    %18 = "http://127.0.0.1:" + move %2
    %3 = move %18
    %19 = "" + copy %3
    %20 = move %19 + "/echo?q=1"
    %21 = request_new input=move %20 method="POST" body="hello body"
    %22 = async_http_fetch(move %21)
    %23 = await move %22
    %4 = move %23
    %24 = response_status copy %4
    %25 = call @console_log(move %24) -> bb7
