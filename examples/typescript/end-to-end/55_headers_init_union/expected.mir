interface InitLike

fn content_type_of (FuncId(0)) -> String
  locals
    %0 param init: List<(String, String)> | Dict<String, String> | Headers
    %1 temp: Headers
    %2 temp: Optional<String>
    %3 temp: String
  bb0:
    %1 = headers_new copy %0
    %2 = headers_get move %1, "content-type"
    %3 = move %2 ?? "none"
    return move %3

fn first_header (FuncId(1)) -> String
  locals
    %0 param init: InitLike
    %1 user copied: Headers
    %2 temp: Headers
    %3 temp: Optional<String>
    %4 temp: String
  bb0:
    %2 = headers_new copy %0.field8
    %1 = move %2
    %3 = headers_get move %1, "a"
    %4 = move %3 ?? "none"
    return move %4

