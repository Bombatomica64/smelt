fn main (FuncId(0)) -> None
  locals
    %0 user port: Float
    %1 user zone: String
    %2 temp: Optional<String>
    %3 temp: String | Float
    %4 temp: Float
    %5 temp: String
    %6 temp: None
    %7 temp: None
  bb0:
    %2 = process_env_read "PORT"
    %3 = move %2 ?? 3000.0
    %4 = primitive_cast_js_number move %3
    %0 = move %4
    %5 = "America/Santiago" ?? "UTC"
    %1 = move %5
    %6 = call @console_log(move %0) -> bb1
  bb1:
    %7 = call @console_log(move %1) -> bb2
  bb2:
    return none

