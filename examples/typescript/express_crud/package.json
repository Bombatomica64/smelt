{
  "name": "express-crud",
  "version": "0.1.0",
  "private": true,
  "description": "A small Express 5 + node:sqlite todo CRUD API used as the Smelt v1 showcase input",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
