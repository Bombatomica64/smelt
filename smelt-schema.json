{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Top-level configuration for a Smelt project.",
  "type": "object",
  "properties": {
    "project": {
      "description": "Project metadata.",
      "$ref": "#/$defs/Project"
    },
    "sources": {
      "description": "Source file configuration.",
      "$ref": "#/$defs/Source"
    },
    "output": {
      "description": "Output target configuration.",
      "$ref": "#/$defs/Output"
    },
    "runtime": {
      "description": "Runtime options.",
      "$ref": "#/$defs/Runtime"
    },
    "rust": {
      "description": "Generated-Rust options.",
      "$ref": "#/$defs/Rust"
    },
    "strict": {
      "description": "Optional strict mode configuration.",
      "anyOf": [
        {
          "$ref": "#/$defs/Strict"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project",
    "sources",
    "output",
    "runtime"
  ],
  "$defs": {
    "Project": {
      "description": "Project metadata from the [project] section of Smelt.toml.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Project name.",
          "type": "string"
        },
        "version": {
          "description": "Project version.",
          "type": "string"
        },
        "description": {
          "description": "Optional project description.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Source": {
      "description": "Source file configuration from the [sources] section.",
      "type": "object",
      "properties": {
        "entries": {
          "description": "List of source file paths.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roots": {
          "description": "Optional list of root directories.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "test-globs": {
          "description": "Optional glob patterns used to discover test source files under roots.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "description": "Optional root-relative glob patterns for source files to exclude.\n\nMatching files are skipped by both build and probe file discovery. The\nglob syntax matches [`test_globs`](Self::test_globs): `*` spans one path\nsegment and `**` spans zero or more segments, always with `/` separators.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "entries"
      ]
    },
    "Output": {
      "description": "Output configuration from the [output] section.",
      "type": "object",
      "properties": {
        "target": {
          "description": "Target output directory.",
          "type": "string"
        },
        "crate-name": {
          "description": "Optional crate name override.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Generated Rust crate target kind.",
          "$ref": "#/$defs/OutputKind"
        },
        "build": {
          "description": "Whether to build the generated crate.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "target"
      ]
    },
    "OutputKind": {
      "description": "Kind of Rust crate target emitted by Smelt.",
      "oneOf": [
        {
          "description": "Generate an executable Rust program rooted at `src/main.rs`.",
          "type": "string",
          "const": "program"
        },
        {
          "description": "Generate a Rust library crate rooted at `src/lib.rs`.",
          "type": "string",
          "const": "library"
        }
      ]
    },
    "Runtime": {
      "description": "Runtime configuration from the [runtime] section.",
      "type": "object",
      "properties": {
        "clone-strategy": {
          "description": "Cloning strategy for generated code.",
          "$ref": "#/$defs/CloneStrategy"
        }
      },
      "required": [
        "clone-strategy"
      ]
    },
    "CloneStrategy": {
      "description": "Strategy for cloning values in generated code.",
      "oneOf": [
        {
          "description": "Always clone values.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Aggressively clone when beneficial.",
          "type": "string",
          "const": "aggressive"
        },
        {
          "description": "Never clone values.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "Rust": {
      "description": "Generated-Rust configuration from the [rust] section.",
      "type": "object",
      "properties": {
        "allocator": {
          "description": "Global allocator a generated program installs.",
          "$ref": "#/$defs/Allocator"
        },
        "release-profile": {
          "description": "`[profile.release]` the generated crate carries.",
          "$ref": "#/$defs/ReleaseProfile"
        }
      }
    },
    "Allocator": {
      "description": "Global allocator a generated program installs.\n\nGenerated code allocates far more than hand-written Rust does — every\nJavaScript array, object and string is a separate heap value with reference\nsemantics — so the allocator is a larger share of the profile than any single\nemitter decision. See `smelt_codegen_rust::GeneratedAllocator`.",
      "oneOf": [
        {
          "description": "Leave the platform allocator in place. The default: see\n`smelt_codegen_rust::GeneratedAllocator` for why Smelt does not choose\nan allocator on the application author's behalf.",
          "type": "string",
          "const": "system"
        },
        {
          "description": "Install `mimalloc`, which suits this workload's small short-lived values.",
          "type": "string",
          "const": "mimalloc"
        }
      ]
    },
    "ReleaseProfile": {
      "description": "`[profile.release]` the generated crate carries.\n\nSee `smelt_codegen_rust::ReleaseProfile`: Cargo's stock release profile never\ninlines across a codegen unit, and in generated code the runtime prelude is on\nthe far side of that boundary from every hot loop.",
      "oneOf": [
        {
          "description": "Thin LTO and one codegen unit. The default.",
          "type": "string",
          "const": "optimized"
        },
        {
          "description": "Cargo's stock release profile.",
          "type": "string",
          "const": "default"
        }
      ]
    },
    "Strict": {
      "description": "Strict mode configuration from the [strict] section.",
      "type": "object",
      "properties": {
        "typescript": {
          "description": "Enable strict mode for TypeScript.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "python": {
          "description": "Enable strict mode for Python.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
