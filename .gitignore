# Generated by Cargo
# will have compiled files and executables
debug
target

# Local checkouts made by scripts/checkout_probe_libraries.py. Deliberately not
# under target/: the CI cargo cache restores target/ and would strip the probe
# worktrees while leaving their .git dirs behind.
/.library-probes/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
.codex
codedb.snapshot
dist/
dist-smelt/

# Analysis/profiling scratch output — never track
.codex-tmp/
graphify-out/
crates/graphify-out/
perf.data
perf.data.old

# Investigation reports are scratch output; keep the directory, not the logs
blocker-logs/*.md
# Tracked: the live files listed in blocker-logs/README.md. An investigation
# report in flight is committed with `git add -f` and deleted when it closes.
!blocker-logs/README.md
!blocker-logs/OPEN-QUESTIONS.md
!blocker-logs/library-probes.md
!blocker-logs/smelt-unknown-report.md
!blocker-logs/typedness-report.md
!blocker-logs/ts7-parity.md
!blocker-logs/globals-suite-failures.md
!blocker-logs/express-v1-baseline.md
!blocker-logs/hono-campaign-plan.md
!blocker-logs/hono-current.md
!blocker-logs/hono-crud-status.md
!blocker-logs/hono-crud-python-app.md
!blocker-logs/hono-fetch-demand.md
!blocker-logs/hono-phase3-round1-families.md
!blocker-logs/probe-date-fns.md
!blocker-logs/probe-cachetools.md

# Generated docs site output
_site/

# Agent worktrees are transient checkouts created under .claude/, never part of the tree
.claude/worktrees/

# Probe library checkouts (see .github/compat/libraries.json for pinned refs)
third_party/es-toolkit/
third_party/radash/
third_party/remeda/

# Benchmark artifacts: bundled third-party TypeScript and raw result JSON,
# both regenerated by benchmarks/prepare.py and benchmarks/run.py.
benchmarks/ts/vendor/
probe.json

# shared cargo target for the es-toolkit probe crate used by parallel implementer worktrees
/target-estk/

# private per-worktree cargo target dirs for parallel implementer agents
/target-priv/
/target-estk-priv/
# private cargo target dirs for the remeda/radash regression gates run locally
/target-rem-priv/
/target-rad-priv/
/target-gates/

# examples/typescript/hono_crud is a real npm project: its installed
# dependencies and local SQLite file are never tracked (dist/ is covered above).
node_modules/
examples/typescript/hono_crud/todos.db

# Hono probe checkout (see .github/compat/libraries.json for the pinned ref)
third_party/hono/

# private cargo target dir for generated-crate gates run locally
/target-gen-priv/
/target-gen-priv2/
# saved smelt binary used while a target dir is cleaned
/smelt-bin
# Hono probe checkout is cloned by CI and locally, never tracked
third_party/hono

# local clones for corpus gates (radash etc.), never tracked
/target-compat/
third_party/es-toolkit-src/

target-*/

# Coverage tracefile: a CI artifact, 7.5 MB per revision if committed.
lcov.info

# Python bytecode
__pycache__/

# The pinned Node type declarations the embedded TypeScript checker loads.
!crates/smelt-ts-types/vendor/node_modules/
