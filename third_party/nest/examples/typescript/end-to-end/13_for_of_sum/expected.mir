fn main (FuncId(0)) -> None
  locals
    %0 user xs: List<Float>
    %1 user sum: Float
    %2 user x: Float
    %3 temp: List<Float>
    %4 temp: Float
    %5 temp: Float
    %6 temp: Bool
    %7 temp: Float
    %8 temp: None
  bb0:
    %3 = [1.0, 2.0, 3.0]
    %0 = copy %3
    %1 = 0.0
    %4 = 0.0
    goto bb1
  bb1:
    %5 = len copy %0
    %6 = copy %4 < copy %5
    switch copy %6 ? bb2 : bb4
  bb2:
    %2 = copy %0[copy %4]
    %7 = copy %1 + copy %2
    %1 = copy %7
    goto bb3
  bb3:
    %4 = copy %4 + 1.0
    goto bb1
  bb4:
    %8 = call @console_log(copy %1) -> bb5
  bb5:
    return none

